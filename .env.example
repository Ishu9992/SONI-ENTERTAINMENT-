# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/castle?retryWrites=true&w=majority

# JWT secret for auth tokens
JWT_SECRET=replace_with_a_long_random_string

# Admin bootstrap (used by scripts/seed.js to create the first Admin account)
ADMIN_EMAIL=ishu@sonimediastudios.com
ADMIN_PASSWORD=change_me_immediately

# UPI payment target shown on the checkout screen
NEXT_PUBLIC_UPI_ID=8076077522@ybl
NEXT_PUBLIC_UPI_PAYEE_NAME=Ishu Soni | Soni Media Studios

# (Optional) SMS/OTP provider — Twilio, MSG91, etc. Leave blank to use the
# built-in console-log OTP stub for local development.
OTP_PROVIDER_API_KEY=
